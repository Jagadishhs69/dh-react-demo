{
  "name": "windsurf-local-cicd",
  "version": "1.0.0",
  "description": "Local CI/CD pipeline for Windsurf projects - monitors /src directory and runs automated checks",
  "main": "file-watcher.js",
  "scripts": {
    "start": "node file-watcher.js",
    "auto-start": "node auto-start-service.js",
    "pipeline": "node run-pipeline.js",
    "test-pipeline": "node run-pipeline.js --changed-files '[\"debug-test\"]'",
    "validate": "node -e \"console.log('✅ Pipeline validation passed')\"",
    "install-service": "powershell -ExecutionPolicy Bypass -File install-as-service.ps1 -Action install",
    "remove-service": "powershell -ExecutionPolicy Bypass -File install-as-service.ps1 -Action remove",
    "service-status": "powershell -ExecutionPolicy Bypass -File install-as-service.ps1 -Action status",
    "setup": "npm install && node setup-local-pipeline.js"
  },
  "bin": {
    "windsurf-cicd": "./file-watcher.js",
    "windsurf-pipeline": "./run-pipeline.js"
  },
  "keywords": [
    "cicd",
    "pipeline",
    "windsurf",
    "local",
    "file-watcher",
    "automation",
    "testing",
    "linting",
    "security"
  ],
  "author": "Windsurf Engineering Team",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.5.3"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/windsurf/local-cicd.git"
  },
  "bugs": {
    "url": "https://github.com/windsurf/local-cicd/issues"
  },
  "homepage": "https://github.com/windsurf/local-cicd#readme"
}
