#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# Stage 1: Run existing lint-staged
echo "📝 Linting staged files..."
npx lint-staged

# Stage 2: Run Windsurf Pipeline (Complete System)
echo "🚀 Running Windsurf CI/CD Pipeline..."
node windsurf-pipeline/local-pipeline/run-pipeline.js --mode=pre-commit

echo "✅ Pre-commit checks completed!"
